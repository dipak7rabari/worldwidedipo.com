# ============================================================
# WORLDWIDE DIPO — ENVIRONMENT VARIABLES
# DIPO LABS
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NEXT_PUBLIC_BASE_URL=https://worldwidedipo.com


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY — NEVER EXPOSE IN BROWSER
SUPABASE_SECRET_KEY=sb_secret_xxx


# ------------------------------------------------------------
# UPI / Payments
# ------------------------------------------------------------

NEXT_PUBLIC_UPI_ID=your-official-upi-id@bank
NEXT_PUBLIC_PAYEE_NAME=Worldwide DIPO


# ------------------------------------------------------------
# Cloudflare Turnstile
# ------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# SERVER ONLY — NEVER EXPOSE IN BROWSER
TURNSTILE_SECRET_KEY=your-turnstile-secret-key


# ------------------------------------------------------------
# Cron Security
# ------------------------------------------------------------

# SERVER ONLY — NEVER EXPOSE IN BROWSER
CRON_SECRET=generate-a-long-random-secret


# ------------------------------------------------------------
# Optional Distributed Rate Limiting
# ------------------------------------------------------------

# Leave blank unless Upstash Redis is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Admin allowlist (comma separated, lowercase emails)
# ------------------------------------------------------------

# SERVER ONLY
ADMIN_EMAILS=admin1@example.com,admin2@example.com
